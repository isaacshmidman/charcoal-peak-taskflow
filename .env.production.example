# Taskflow production environment — copy to .env on your ZimaBlade
# ─────────────────────────────────────────────────────────────

# App
TASKFLOW_APP_ID=69b71a4b57ba76a74090fc6e
TASKFLOW_PUBLIC_APP_URL=https://peaktaskflow.com

# Session security — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TASKFLOW_SESSION_SECRET=

# Google OAuth (from Google Cloud Console → Credentials)
TASKFLOW_GOOGLE_CLIENT_ID=
TASKFLOW_GOOGLE_CLIENT_SECRET=
TASKFLOW_GOOGLE_REDIRECT_URL=https://peaktaskflow.com/api/apps/auth/google/callback

# Auth
TASKFLOW_ALLOW_ANY_PASSWORD=false

# Data retention
TASKFLOW_DELETED_TASK_RETENTION_DAYS=7

# Cloudflare Tunnel (from Zero Trust dashboard → Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# ZimaOS dynamic port (leave as-is, ZimaOS sets this automatically)
# WEBUI_PORT=8787
