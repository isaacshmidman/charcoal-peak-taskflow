# Taskflow production environment — copy to .env on your ZimaBlade
# ─────────────────────────────────────────────────────────────

# App
TASKFLOW_APP_ID=69b71a4b57ba76a74090fc6e
TASKFLOW_PUBLIC_APP_URL=https://zephyrly.app

# Where the database and attachments live on this machine. Required: there
# is no default, so the app can never start on a guessed folder.
# ZimaOS convention is below; use a folder on a storage drive if you want the
# data there instead. On a machine that already has data, this must be the
# folder the data is in — pointing it anywhere else starts the app with a
# blank database.
TASKFLOW_DATA_DIR=/DATA/AppData/taskflow/data

# Session security — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TASKFLOW_SESSION_SECRET=

# Google OAuth (from Google Cloud Console → Credentials)
TASKFLOW_GOOGLE_CLIENT_ID=
TASKFLOW_GOOGLE_CLIENT_SECRET=
TASKFLOW_GOOGLE_REDIRECT_URL=https://zephyrly.app/api/apps/auth/google/callback

# Calendar integrations
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATIONS_ENCRYPTION_KEY=
TASKFLOW_INTEGRATIONS_ENABLED=true
TASKFLOW_SYNC_INTERVAL_MS=60000

# Google Calendar OAuth may reuse the login client above. Set these only when
# you want a separate OAuth client for calendar sync.
# Required scopes: calendar.events, calendar.calendars.readonly,
# calendar.calendarlist.readonly, openid, email, profile.
# TASKFLOW_GOOGLE_CALENDAR_CLIENT_ID=
# TASKFLOW_GOOGLE_CALENDAR_CLIENT_SECRET=
TASKFLOW_GOOGLE_CALENDAR_REDIRECT_URL=https://zephyrly.app/api/apps/69b71a4b57ba76a74090fc6e/integrations/google/callback

# Device notifications
# Generate with:
#   npx web-push generate-vapid-keys
TASKFLOW_VAPID_PUBLIC_KEY=
TASKFLOW_VAPID_PRIVATE_KEY=
TASKFLOW_VAPID_SUBJECT=mailto:admin@zephyrly.app
TASKFLOW_NOTIFICATION_POLL_MS=60000

# Auth
TASKFLOW_ALLOW_ANY_PASSWORD=false

# Data retention
TASKFLOW_DELETED_TASK_RETENTION_DAYS=7

# Cloudflare Tunnel (from Zero Trust dashboard → Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# ZimaOS dynamic port (leave as-is, ZimaOS sets this automatically)
# WEBUI_PORT=8787
